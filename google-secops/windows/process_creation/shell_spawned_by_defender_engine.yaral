rule shell_spawned_by_defender_engine {

  meta:
    status = "experimental"
    author = "nicgarci"
    description = "Detects an interactive shell or scripting host spawned by the Microsoft Defender engine (MsMpEng.exe) at SYSTEM integrity. Consistent with TOCTOU / path-redirection privilege escalation against Defender (e.g., RoguePlanet, BlueHammer, RedSun)."
    reference = "https://www.picussecurity.com/resource/blog/rogueplanet-anatomy-of-the-nightmare-eclipse-microsoft-defender-zero-day#detection-engineering"
    data_source = "Microsoft Defender for Endpoint"
    severity = "Medium"
    priority = "Medium"
    mitre_attack_tactic = "TA0002"
    mitre_attack_technique = "T1059"

  events:
    $e.metadata.product_name = "Microsoft Defender for Endpoint"
    $e.metadata.event_type = "PROCESS_LAUNCH"
    $e.principal.process.parent_process.file.names = "MsMpEng.exe"
    (
    $e.principal.process.file.names = "cmd.exe" or 
    $e.principal.process.file.names = "powershell.exe" or 
    $e.principal.process.file.names = "pwsh.exe" or 
    $e.principal.process.file.names = "conhost.exe" or 
    $e.principal.process.file.names = "wscript.exe" or 
    $e.principal.process.file.names = "cscript.exe"
    )
    $e.additional.fields["initiating_process_integrity_level"] = "System"

  outcome:
    $target_host = array_distinct($e.principal.hostname)
    $principal_process_pid = array_distinct($e.principal.process.pid)
    $principal_process_name = array_distinct($e.principal.process.file.names)
    $principal_process_command_line = array_distinct($e.principal.process.command_line)
    $principal_parent_process_pid = array_distinct($e.principal.process.parent_process.pid)
    $principal_parent_process_name = array_distinct($e.principal.process.parent_process.file.names)

  condition:
    $e

}